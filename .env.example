# Leave DATABASE_URL unset locally to use the embedded PGlite database (./data/pglite).
# On Railway, add the Postgres plugin and reference its variable: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Server
PORT=3000
NODE_ENV=development

# Upload limit in megabytes
MAX_UPLOAD_MB=50

# 1 = January (calendar year). Set to e.g. 2 if your fiscal year starts in February.
FISCAL_YEAR_START_MONTH=1

# 0 = Sunday, 1 = Monday
WEEK_STARTS_ON=1
